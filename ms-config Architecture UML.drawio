  <diagram id="mChp6Jj5XfDnAfWz8aQH" name="Diag - Secuencia">
    <mxGraphModel dx="1250" dy="1377" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Dev as Developer / Microservice Client\n    participant ConfigController as EnvironmentController (Spring Cloud)\n    participant EnvRepo as EnvironmentRepository (Git / Native)\n    participant Storage as Config Files (ms-*.yml)\n\n    Dev-&gt;&gt;ConfigController: GET /{application}/{profile} (e.g., /ms-customer/default)\n    activate ConfigController\n    ConfigController-&gt;&gt;EnvRepo: findOne(application, profile, label)\n    activate EnvRepo\n    EnvRepo-&gt;&gt;Storage: Read ms-customer.yml\n    activate Storage\n    Storage--&gt;&gt;EnvRepo: Return YAML properties\n    deactivate Storage\n    EnvRepo--&gt;&gt;ConfigController: Environment Object (PropertySources)\n    deactivate EnvRepo\n    ConfigController--&gt;&gt;Dev: HTTP 200 OK (JSON with MongoDB URI, Server Port, Log levels)\n    deactivate ConfigController&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="rDxU263McYCN1DQxHbFS-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
